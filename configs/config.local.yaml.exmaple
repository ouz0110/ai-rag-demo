secret: your-secret-key-placeholder
name: ai_rag_demo_api
env: local
version: v1.0.0
i18n:
  default: zh-hans-cn
  config_group: AI_RAG_DEMO_API_GROUP
  config:
    - active.zh-cn.toml
service:
server:
  domain: ${SRV_DOMAIN:https://dev.example.com/demo/api}
  http:
    addr: 0.0.0.0:8001
    timeout: 300s
  grpc:
    addr: 0.0.0.0:8002
    timeout: 5s
  srv:
source:
  log:
    level: debug
  aes_ecb:
    code: "0123456789012345"
  otel:
    enable: false
    endpoint: "localhost:4317" # jaeger上报端口
    sample_rate: 1
    std_out: true
  redis:
    base:
      password: "123456"
      addrs: 127.0.0.1:6379
      read_timeout: 0.2s
      write_timeout: 0.2s
  mysql_default_ca:
  database:
    base:
      driver: mysql
      source: root:123456@tcp(127.0.0.1:3306)/base?parseTime=true&charset=utf8mb4
      auto_migrate: off
      max_idle_conns: 200
      max_open_conns: 200
      max_lifetime: 600
  nacos:
    addr: nacos-dev.example.com
    port: "80"
    access_key_id:
    access_key_secret:
    namespace:
    log:
      level: debug
  openai:
    api_key: "sk-your-openai-api-key-placeholder"
    base_url: "https://api.openai.com/v1"
    model: "gpt-4o"
    context_compress:
      enable: true
      max_context_tokens: 128000
      compress_ratio: 0.75
      max_compress_count: 5
      min_uncompressed_msgs: 6
      keep_recent_messages: 6
      max_summary_tokens: 500
      timeout: 30                         # 摘要生成硬超时时间 (单位：秒)
  vector_db:
    driver: "milvus"
    milvus:
      address: "localhost:19530"
      db_name: "default"
      collection_name: "rag_knowledge"
      dimension: 1536
  rag:
    enable: true                            # 是否开启 RAG 知识库检索全局总开关
    knowledge_dir: "./workspace/knowledge"
    upload_dir: "./workspace/uploads"
    auto_reload: true
    top_k: 5
    score_threshold: 0.6
    embedding:
      api_key: "ollama"
      base_url: "http://localhost:11434/v1" # Ollama 本地 API 地址
      model: "bge-m3"                       # Ollama 向量模型
      dimension: 1024                       # 向量维度配置 (如 1024, 1536, 768)
    rerank:
      enable: true
      driver: "llm"                         # 使用 OpenAI 兼容模式直连 Ollama 重排服务
      api_key: "ollama"
      base_url: "http://localhost:11434/v1" # Ollama 本地 API 地址
      model: "bge-reranker-large"           # Ollama 挂载的模型
      timeout: 2000                         # 重排超时 (2000ms)
    billing:
      enable: true
      default_prices:
        "gpt-4o":
          input_unit_price: 0.2
          output_unit_price: 0.8
          unit_size: 1000
        "bge-m3":
          input_unit_price: 0.5
          output_unit_price: 0.6
          unit_size: 1000
        "bge-reranker-large":
          input_unit_price: 0.1
          output_unit_price: 0.5
          unit_size: 1000
    chunker:
      parent_size: 1500
      child_size: 512
      overlap: 30
      merge_threshold: 0.75
      split_threshold: 0.45
  skill:
    enable: true                            # 是否开启 Skill 技能扩展系统全局总开关
    path: "./skills"
  nocli:
    work_dir: "./workspace/agent"
    max_agent_iterations: 15
    max_read_files: 20
    max_total_bytes: 51200
    chunk_lines: 1000
    ignored_paths:
      - ".git"
      - "node_modules"
      - "vendor"
      - ".idea"
      - ".vscode"
      - "dist"
      - "build"
      - "tmp"
      - "logs"
    allowed_suffixes:
      - ".go"
      - ".proto"
      - ".yaml"
      - ".yml"
      - ".json"
      - ".md"
      - ".sql"
      - ".sh"
external:
