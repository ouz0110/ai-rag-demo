secret: 87S7yST0Bx249iSqxUhzR
name: demo_api
env: local
version: v1.0.0
i18n:
  default: zh-hans-cn
  config_group: DEMO_API_GROUP
  config:
    - active.zh-cn.toml
service:
server:
  domain: ${SRV_DOMAIN:https://dev.demo.com/demo/api}
  http:
    addr: 0.0.0.0:8001
    timeout: 300s
  grpc:
    addr: 0.0.0.0:8002
    timeout: 5s
  srv:
source:
  log:
    level: debug
    enable_trace_log: true                   # 🎯 是否开启本地日志打印 LLM 全链路切面 (OnAgentStart/OnLLMStart/OnToolStart)
  aes_ecb:
    code: "0123456789012345"
  otel:
    enable: false
    endpoint: "localhost:4317" # jaeger上报端口
    sample_rate: 1
    std_out: true
    timeout: 5s
  redis:
    base:
      password: "123456"
      addrs: 127.0.0.1:6379
      read_timeout: 0.2s
      write_timeout: 0.2s
  mysql_default_ca:
  database:
    base:
      driver: mysql
      source: root:123456@tcp(127.0.0.1:3306)/base?parseTime=true&charset=utf8mb4
      auto_migrate: off
      max_idle_conns: 200
      max_open_conns: 200
      max_lifetime: 600
  nacos:
    addr: nacos-dev.demo.com
    port: "80"
    access_key_id:
    access_key_secret:
    namespace:
    log:
      level: debug
  openai:
    api_key: "xxx"
    base_url: "https://api.deepseek.com"
    model: "deepseek-v3.2"
    context_compress:
      enable: true
      max_context_tokens: 16384              # 模型最大上下文 Token 数 (以 16k 为例)
      compress_ratio: 0.75                   # 🎯 触发阈值水线 (75%，即达到约 12288 Tokens 时触发压缩)
      target_compress_ratio: 0.35            # 🎯 压缩后的目标上下文比例 (35%，即压缩降至总容量的 35%)
      max_compress_count: 5                  # 单会话最大 LLM 摘要压缩次数 (达到后启动 FIFO 滚动熔断)
      min_uncompressed_msgs: 4                # 两次压缩之间至少积累的增量消息条数 (防频繁压缩)
      keep_recent_messages: 4                # 压缩时固定保留的最新消息条数 (确保近期对话连贯)
      max_summary_tokens: 800                # 生成 Checkpoint 摘要的最大 Token 数 (500-1000t)
      timeout: 30s                           # 摘要生成硬超时时间 (30秒)
  skill:
    enable: true                            # 是否开启 Skill 技能扩展系统全局总开关
    path: "./workspace/skills"
  mcp:
    enable: false                            # 是否开启 MCP 工具扩展系统全局总开关
    client_info:
      name: "ai-rag-demo-agent"
      version: "1.0.0"
    default_timeout: 30s
    servers:
      - name: "08demo"
        description: "08demo每日用量统计"
        url: "http://localhost:8081/sse"
        enabled: true
        headers:
        timeout: 10s
        max_retries: 5
        retry_interval: 2s
  vector_db:
    driver: "milvus"
    milvus:
      address: "localhost:19530"
      username: ""
      password: ""
      token: ""
      api_key: ""
      db_name: "default"
      collection_name: "rag_knowledge"
      dimension: 1024
      timeout: 5s
  rag:
    enable: true 
    knowledge_dir: "./workspace/knowledges"
    upload_dir: "./workspace/uploads"
    auto_reload: true
    top_k: 5
    score_threshold: 0.6
    timeout: 60s                             # 检索硬超时时间
    embedding:
      api_key: "ollama"
      base_url: "http://localhost:8091/v1" # Ollama 本地 Embedding API 接口地址
      model: "Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0"           # Ollama 中加载的向量模型 (如 bge-m3 / nomic-embed-text)
      dimension: 1024                       # 向量维度 (通过配置灵活传入，如 1024 / 1536 / 768)
    rerank:
      enable: true
      driver: "qianfan" # 使用 OpenAI 兼容模式直连 Ollama 本地重排/打分服务
      api_key: "ollama"
      base_url: "http://localhost:8090/v1/rerank" # Ollama 本地服务接口地址
      model: "gpustack/bge-reranker-v2-m3-GGUF:Q8_0"           # Ollama 中加载的重排模型名称
      timeout: 2000                         # 重排硬超时 (2000ms)
    billing:
      enable: true
      default_prices:
        "deepseek-v3.2":
          input_unit_price: 0.2
          output_unit_price: 0.8
          unit_size: 1000
        "Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0":
          input_unit_price: 0.5
          output_unit_price: 0.6
          unit_size: 1000
        "gpustack/bge-reranker-v2-m3-GGUF:Q8_0":
          input_unit_price: 0.1
          output_unit_price: 0.5
          unit_size: 1000
    chunker:
      parent_size: 1500
      child_size: 512
      overlap: 30
      merge_threshold: 0.75
      split_threshold: 0.45
  nocli:
    work_dir: "./workspace/agent"
    max_agent_iterations: 15                 # 🎯 全局 Agent 默认最大 ReAct 循环迭代次数
    exec_timeout: 5m                         # 🎯 Agent 单次任务总执行超时时间 (5分钟)
    default_tool_timeout: 60s               # 🎯 工具默认调用超时时间 (60秒)
    tool_timeouts:                          # 🎯 特定工具调用超时配置
      terminal: 5m
      delegate_to_rag_agent: 5m
      call_mcp_tool: 30s
      load_skill: 15s
    agents:                                 # 🎯 特定 Agent 配置重写 (包含迭代次数 max_iterations 与独享超时 timeout)
      main:
        max_iterations: 20                  # 主 Agent 最大循环次数 (默认 20 次)
        timeout: 5m                          # 主 Agent 独享硬超时时间 (5分钟)
      file_analyzer:
        max_iterations: 10                  # 文件分析子 Agent 最大循环次数 (10 次)
        timeout: 3m                          # 文件分析子 Agent 独享硬超时时间 (3分钟，超时优雅返回阶段性结果给主 Agent)
      rag_agent:
        max_iterations: 10                  # RAG 检索子 Agent 最大循环次数 (10 次)
        timeout: 2m                          # RAG 检索子 Agent 独享硬超时时间 (2分钟，超时优雅返回阶段性结果给主 Agent)
    allowed_paths:
      - "./workspace/skills"
      - "./workspace/knowledges"
      - "/tmp"
    max_read_files: 20
    max_total_bytes: 51200
    chunk_lines: 1000
    ignored_paths:
      - ".git"
      - "node_modules"
      - "vendor"
      - ".idea"
      - ".vscode"
      - "dist"
      - "build"
      - "tmp"
      - "logs"
    allowed_suffixes:
      - ".go"
      - ".proto"
      - ".yaml"
      - ".yml"
      - ".json"
      - ".md"
      - ".sql"
      - ".sh"
external:

