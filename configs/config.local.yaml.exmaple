secret: 87S7yST0Bx249iSqxUhzR
name: demo_api
env: local
version: v1.0.0
i18n:
  default: zh-hans-cn
  config_group: DEMO_API_GROUP
  config:
    - active.zh-cn.toml
service:
server:
  domain: ${SRV_DOMAIN:https://dev.demo.com/demo/api}
  http:
    addr: 0.0.0.0:8001
    timeout: 300s
  grpc:
    addr: 0.0.0.0:8002
    timeout: 5s
  srv:
source:
  log:
    level: debug
    
  aes_ecb:
    code: "0123456789012345"
  otel:
    enable: false
    endpoint: "localhost:4317" # jaeger上报端口
    sample_rate: 1
    std_out: true
  redis:
    base:
      password: "123456"
      addrs: 127.0.0.1:6379
      read_timeout: 0.2s
      write_timeout: 0.2s
  mysql_default_ca:
  database:
    base:
      driver: mysql
      source: root:123456@tcp(127.0.0.1:3306)/base?parseTime=true&charset=utf8mb4
      auto_migrate: off
      max_idle_conns: 200
      max_open_conns: 200
      max_lifetime: 600
  nacos:
    addr: nacos-dev.demo.com
    port: "80"
    access_key_id:
    access_key_secret:
    namespace:
    log:
      level: debug
  openai:
    api_key: "xxx"
    base_url: "https://api.deepseek.com"
    model: "deepseek-v3.2"
    context_compress:
      enable: true
      max_context_tokens: 8098
      compress_ratio: 0.75
      max_compress_count: 2
      min_uncompressed_msgs: 2
      keep_recent_messages: 2
      max_summary_tokens: 500
      timeout: 300                         # 摘要生成硬超时时间 (单位：秒)
  skill:
    enable: true                            # 是否开启 Skill 技能扩展系统全局总开关
    path: "./workspace/skills"
  mcp:
    enable: false                            # 是否开启 MCP 工具扩展系统全局总开关
    client_info:
      name: "ai-rag-demo-agent"
      version: "1.0.0"
    default_timeout: 30s
    servers:
      - name: "08demo"
        description: "08demo每日用量统计"
        url: "http://localhost:8081/sse"
        enabled: true
        headers:
        timeout: 10s
        max_retries: 5
        retry_interval: 2s
  vector_db:
    driver: "milvus"
    milvus:
      address: "localhost:19530"
      db_name: "default"
      collection_name: "rag_knowledge"
      dimension: 1024
  rag:
    enable: true 
    knowledge_dir: "./workspace/knowledges"
    upload_dir: "./workspace/uploads"
    auto_reload: true
    top_k: 5
    score_threshold: 0.6
    embedding:
      api_key: "ollama"
      base_url: "http://localhost:8091/v1" # Ollama 本地 Embedding API 接口地址
      model: "Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0"           # Ollama 中加载的向量模型 (如 bge-m3 / nomic-embed-text)
      dimension: 1024                       # 向量维度 (通过配置灵活传入，如 1024 / 1536 / 768)
    rerank:
      enable: true
      driver: "qianfan" # 使用 OpenAI 兼容模式直连 Ollama 本地重排/打分服务
      api_key: "ollama"
      base_url: "http://localhost:8090/v1/rerank" # Ollama 本地服务接口地址
      model: "gpustack/bge-reranker-v2-m3-GGUF:Q8_0"           # Ollama 中加载的重排模型名称
      timeout: 2000                         # 重排硬超时 (2000ms)
    billing:
      enable: true
      default_prices:
        "deepseek-v3.2":
          input_unit_price: 0.2
          output_unit_price: 0.8
          unit_size: 1000
        "Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0":
          input_unit_price: 0.5
          output_unit_price: 0.6
          unit_size: 1000
        "gpustack/bge-reranker-v2-m3-GGUF:Q8_0":
          input_unit_price: 0.1
          output_unit_price: 0.5
          unit_size: 1000
    chunker:
      parent_size: 1500
      child_size: 512
      overlap: 30
      merge_threshold: 0.75
      split_threshold: 0.45
  nocli:
    work_dir: "./workspace/agent"
    allowed_paths:
      - "./workspace/skills"
      - "./workspace/knowledges"
      - "/tmp"
    max_read_files: 20
    max_total_bytes: 51200
    chunk_lines: 1000
    ignored_paths:
      - ".git"
      - "node_modules"
      - "vendor"
      - ".idea"
      - ".vscode"
      - "dist"
      - "build"
      - "tmp"
      - "logs"
    allowed_suffixes:
      - ".go"
      - ".proto"
      - ".yaml"
      - ".yml"
      - ".json"
      - ".md"
      - ".sql"
      - ".sh"
external:

