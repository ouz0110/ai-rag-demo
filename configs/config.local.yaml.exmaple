secret: 87S7yST0Bx249iSqxUhzR
name: ai_rag_demo_api
env: local
version: v1.0.0
i18n:
  default: zh-hans-cn
  config_group: AI_RAG_DEMO_API_GROUP
  config:
    - active.zh-cn.toml
service:
server:
  domain: ${SRV_DOMAIN:https://dev.ai-rag-demo.com/ai-rag-demo/api}
  http:
    addr: 0.0.0.0:8001
    timeout: 15s
  grpc:
    addr: 0.0.0.0:8002
    timeout: 5s
  srv:
source:
  log:
    level: debug
  aes_ecb:
    code: "0123456789012345"
  otel:
    enable: false
    endpoint: "localhost:4317" # jaeger上报端口
    sample_rate: 1
    std_out: true
  redis:
    base:
      password: "123456"
      addrs: 127.0.0.1:6379
      read_timeout: 0.2s
      write_timeout: 0.2s
  mysql_default_ca:
  database:
    base:
      driver: mysql
      source: root:123456@tcp(127.0.0.1:3306)/base?parseTime=true&charset=utf8mb4
      auto_migrate: off
      max_idle_conns: 200
      max_open_conns: 200
      max_lifetime: 600
  nacos:
    addr: nacos-dev.ai-rag-demo.com
    port: "80"
    access_key_id:
    access_key_secret:
    namespace:
    openai:
    api_key: "sk-xxx"
    base_url: "https://api.openai.com/v1"
    model: "gpt-4o"
  vector_db:
    driver: "milvus"
    milvus:
      address: "localhost:19530"
      db_name: "default"
      collection_name: "rag_knowledge"
      dimension: 1536
  rag:
    knowledge_dir: "./workspace/knowledge"
    upload_dir: "./workspace/uploads"
    auto_reload: true
    top_k: 5
    score_threshold: 0.6
    embedding:
      api_key: "ollama"
      base_url: "http://localhost:11434/v1" # Ollama 本地 API 地址
      model: "bge-m3"                       # Ollama 向量模型
      dimension: 1024                       # 向量维度配置 (如 1024, 1536, 768)
    rerank:
      enable: true
      driver: "llm"                        # 使用 OpenAI 兼容模式直连 Ollama 重排服务
      api_key: "ollama"
      base_url: "http://localhost:11434/v1" # Ollama 本地 API 地址
      model: "bge-reranker-large"           # Ollama 挂载的模型
      timeout: 2000                         # 重排超时 (2000ms)
    chunker:
      parent_size: 1500
      child_size: 512
      overlap: 30
      merge_threshold: 0.75
      split_threshold: 0.45
external:
